{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"],
      "@style/*": ["./src/style/*"],
      "@components/*": ["./src/components/*"],
      "@features/*": ["./src/features/*"],
      "@client/*": ["./src/client/*"],
      "@router/*": ["./src/router/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "test/**/*.ts"]
}
