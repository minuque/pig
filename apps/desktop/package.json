{
  "name": "@pig/desktop",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./electron-main.mjs",
  "scripts": {
    "dev": "electron . -- --dev",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
