{
  "name": "pig",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:debug": "tsx --inspect=9229 scripts/dev.ts --debug",
    "dev:desktop": "pnpm --filter @pig/desktop dev",
    "dev:gateway": "pnpm --filter @pig/gateway dev",
    "dev:web": "pnpm --filter @pig/web dev",
    "build": "pnpm --filter @pig/web build",
    "start": "pnpm build && tsx packages/gateway/src/cli.ts apps/web/dist",
    "preview": "pnpm --filter @pig/web preview",
    "test": "pnpm -r --if-present test",
    "typecheck": "tsc --noEmit -p scripts/tsconfig.json && pnpm -r --if-present typecheck",
    "lint": "eslint . && designmd lint DESIGN.md",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "pnpm format && eslint . --fix",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:design-tokens",
    "check:design-tokens": "node scripts/verify-design-tokens.mjs",
    "check:release": "pnpm check && pnpm build && pnpm smoke:packed",
    "smoke:packed": "node scripts/smoke-packed.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^10.0.1",
    "@google/design.md": "0.3.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,vue}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,jsonc,css,html,md,yml,yaml}": "prettier --write"
  }
}
