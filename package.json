{
  "name": "no-pi-no-gang-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.19.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:gateway": "pnpm --filter @no-pi-no-gang/gateway dev",
    "dev:web": "pnpm --filter @no-pi-no-gang/web dev",
    "build": "pnpm --filter @no-pi-no-gang/web build",
    "preview": "pnpm --filter @no-pi-no-gang/web preview",
    "prestart": "pnpm build",
    "start": "tsx packages/gateway/src/cli.ts packages/web/dist",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm lint:code && pnpm lint:design",
    "lint:code": "eslint .",
    "lint:design": "designmd lint DESIGN.md",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "fix": "pnpm format && pnpm lint:fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^10.0.1",
    "@google/design.md": "0.3.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,vue}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,jsonc,css,html,md,yml,yaml}": "prettier --write"
  }
}
