{
  "name": "pig",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx --tsconfig scripts/tsconfig.json scripts/dev.ts",
    "dev:debug": "tsx --tsconfig scripts/tsconfig.json --inspect=8888 scripts/dev.ts --debug",
    "dev:desktop": "pnpm --filter @pig/desktop dev",
    "build": "pnpm --filter @pig/gateway build",
    "build:web": "pnpm --filter @pig/web build",
    "start:web": "pnpm build:web && tsx --tsconfig packages/gateway/tsconfig.json packages/gateway/src/cli.ts apps/web/dist",
    "start:desktop": "pnpm build:web && pnpm --filter @pig/desktop start",
    "release:win": "node scripts/release-win.mjs",
    "test": "vitest run && node --test \"scripts/**/*.test.mjs\"",
    "test:platform": "vitest run --project @pig/gateway --project @pig/environment --project @pig/extensions --project @pig/desktop && node --test \"scripts/**/*.test.mjs\"",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:electron": "playwright test -c e2e/electron/playwright.config.ts",
    "test:bench": "tsx --tsconfig e2e/tsconfig.json e2e/perf/run.ts",
    "typecheck": "tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json && pnpm -r --if-present typecheck",
    "fix": "prettier --write . && oxlint --fix . && stylelint \"**/*.{css,vue}\" --fix",
    "fix:touched": "node scripts/check/check.mjs --touched --fix",
    "check": "node scripts/check/check.mjs",
    "check:touched": "node scripts/check/check.mjs --touched",
    "check:release": "pnpm check && pnpm build && pnpm test:e2e",
    "setup:worktree": "node scripts/setup-worktree.mjs",
    "arch": "node scripts/arch/build.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@pig/protocol": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "oxlint": "1.95.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.6",
    "stylelint": "17.15.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "prettier --write",
      "oxlint --fix",
      "node scripts/check/no-comments.mjs"
    ],
    "*.vue": [
      "prettier --write",
      "oxlint --fix",
      "node scripts/check/no-comments.mjs",
      "stylelint --cache --cache-location node_modules/.cache/stylelint/cache --fix"
    ],
    "*.css": [
      "prettier --write",
      "stylelint --cache --cache-location node_modules/.cache/stylelint/cache --fix"
    ],
    "*.{json,jsonc,html,md,yml,yaml}": "prettier --write"
  }
}
