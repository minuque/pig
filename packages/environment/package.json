{
  "name": "@pig/environment",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "工具运行的环境：本机或 SSH 主机；执行命令、读写文件、搜索",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./source": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/ssh2": "1.15.6"
  },
  "dependencies": {
    "ssh-config": "5.3.0",
    "ssh2": "1.17.0"
  }
}
