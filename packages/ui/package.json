{
  "name": "@pig/ui",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "可复用的 Vue 3 设计系统：基础 token、主题色板派生与无业务基础组件",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/index.ts",
    "./styles": "./src/styles/index.css",
    "./styles/index.css": "./src/styles/index.css",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/reset.css": "./src/styles/reset.css",
    "./styles/motion.css": "./src/styles/motion.css",
    "./styles/components.css": "./src/styles/components.css",
    "./*": "./src/ui/*/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "vue": "3.5.42"
  },
  "dependencies": {
    "@lucide/vue": "1.72.0",
    "@ui-sdk/core": "0.1.0-beta.14",
    "@ui-sdk/vue": "0.1.0-beta.14"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "vite": "8.3.0",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11"
  }
}
