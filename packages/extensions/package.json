{
  "name": "@pig/extensions",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "pig 内置的 pi 扩展；只用公开 Extension API，pi TUI 里也能安装使用",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/subagent/index.ts",
      "./src/remote-workspace/index.ts",
      "./src/tasks/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@pig/environment": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@pig/protocol": "workspace:*"
  }
}
