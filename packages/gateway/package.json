{
  "name": "@pig/gateway",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pig": "dist/cli.js"
  },
  "files": [
    "dist",
    "web"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "start": "tsx src/cli.ts",
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "pnpm build",
    "postpack": "node ../../scripts/build-package.mjs restore",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-protocol": "0.84.1",
    "@earendil-works/pi-server": "0.84.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1"
  }
}
