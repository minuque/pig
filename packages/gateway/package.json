{
  "name": "@pig/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pig": "dist/cli.js"
  },
  "files": [
    "dist",
    "web"
  ],
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./src/index.d.ts"
    },
    "./src/*": "./src/*"
  },
  "bundledDependencies": [
    "@pig/contracts"
  ],
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "start": "tsx src/cli.ts",
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "pnpm build",
    "postpack": "node ../../scripts/build-package.mjs restore",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@pig/contracts": "0.0.0"
  },
  "devDependencies": {
    "@pig/testkit": "workspace:*",
    "tsx": "^4.23.1"
  }
}
