  "cards": [
    {
      "dot": "cyan",
      "title": "契约与客户端",
      "items": [
        "客户端只依赖 browser-safe contracts，不感知 Pi 对象",
        "REST 承载资源与命令，一个 Gateway SSE 承载在线增量",
        "浏览器、桌面壳和本地 CLI 可复用同一 Gateway 边界"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据所有权",
      "items": [
        "Pi JSONL 是 Session 与会话记录的唯一事实源",
        "SQLite 只保存授权、Run 账本、幂等、revision 和可重建索引",
        "客户端内存只保存草稿、展开状态与未被 durable 状态取代的增量"
      ]
    },
    {
      "dot": "rose",
      "title": "不可违反的边界",
      "items": [
        "Gateway 只绑定随机 127.0.0.1，Workspace Access 不是 Sandbox",
        "同 Session FIFO、跨 Session 有界并行，Interrupted 永不自动重放",
        "凭证、完整 prompt、会话记录和工具 payload 不进入应用日志"
      ]
    }
  ]
