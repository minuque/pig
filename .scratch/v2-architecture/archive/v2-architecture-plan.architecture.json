  "cards": [
    {
      "dot": "cyan",
      "title": "包与契约边界",
      "items": [
        "apps/web → packages/contracts ← apps/gateway",
        "packages/testkit 仅服务测试；生产代码不得依赖",
        "发布物是一个 npm CLI，内含 Gateway、SPA 与不可变 migrations"
      ]
    },
    {
      "dot": "emerald",
      "title": "状态所有权",
      "items": [
        "Router 拥有选中 ID；Vue Query 拥有 REST durable facts",
        "Pinia 仅拥有按 Session / Run 分区的 Live Overlay",
        "敏感 Auth 输入与 composer draft 只短暂存在组件内存"
      ]
    },
    {
      "dot": "rose",
      "title": "安全与恢复不变量",
      "items": [
        "不启用 CORS；Workspace Grant 不是操作系统沙箱",
        "Interrupted Run 绝不自动重放；终态必须 settled + durable",
        "升级前验证 SQLite 备份；应用永不复制或恢复 Pi Agent Root"
      ]
    },
    {
      "dot": "amber",
      "title": "首发验收",
      "items": [
        "Vitest + Playwright + 真实 SQLite + 固定版本真实 Pi",
        "Linux 完整验证；Windows / macOS 从同一 packed artifact 冒烟",
        "四里程碑：安全 Shell → durable Session → 实时并行 → hardening"
      ]
    }
  ]
